# Copy to .env and adjust. Only HYSUI_DOMAIN is required.

# Public hostname clients connect to. Its DNS record must point at this server
# (or your router), and it must NOT go through a proxy such as Cloudflare's orange cloud.
HYSUI_DOMAIN=vpn.example.com

# UDP address the VPN listens on, and the port written into client links
# (set HYSUI_PUBLIC_PORT if your router forwards a different outside port).
HYSUI_LISTEN=:443
#HYSUI_PUBLIC_PORT=443

# Admin panel (plain HTTP; put it behind a reverse proxy for HTTPS).
HYSUI_WEB_LISTEN=:8080
# Initial login. If the password is empty, a random one is printed in the logs on first start.
HYSUI_ADMIN_USER=admin
#HYSUI_ADMIN_PASSWORD=

# Certificate:
#   acme-http   Let's Encrypt, checked over TCP port 80 (default)
#   acme-tls    Let's Encrypt, checked over TCP port 443
#   file        your own certificate: set HYSUI_TLS_CERT and HYSUI_TLS_KEY (paths inside the container)
#   self-signed for testing; client links pin the certificate
HYSUI_TLS_MODE=acme-http
#HYSUI_ACME_EMAIL=you@example.com
# CA: letsencrypt (default), letsencrypt-staging, or an ACME directory URL
#HYSUI_ACME_CA=letsencrypt
# Local port for the check, if a reverse proxy forwards port 80 to another port
#HYSUI_ACME_ALT_PORT=8081
#HYSUI_TLS_CERT=/data/cert.pem
#HYSUI_TLS_KEY=/data/key.pem

# Answer probes like a normal website by proxying this site (empty = plain 404).
#HYSUI_MASQUERADE_URL=https://news.ycombinator.com/

# "Home network" is private IPv4/IPv6 ranges plus this server's own addresses and IPv6
# prefixes (detected automatically). Add more ranges here, comma-separated.
#HYSUI_HOME_EXTRA=203.0.113.0/24

# If the panel sits behind a reverse proxy, list its address so login throttling sees
# real client IPs. "private" trusts all private ranges.
#HYSUI_TRUSTED_PROXIES=192.168.1.20

#HYSUI_LOG_LEVEL=info
